{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nibblets-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker sees every request first: www redirects and /install.sh.
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "nibblets.dev", "custom_domain": true },
    { "pattern": "www.nibblets.dev", "custom_domain": true },
  ],
  "observability": { "enabled": true },
}
